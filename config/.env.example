# HLAgent Environment Variables
# Copy this file to .env and fill in your actual values
# =============================================================================
# HLAgent project root directory
# =============================================================================

# HLAgent root directory on your system
HLAGENT_MAIN_DIRECTORY=your_hlagent_main_directory_here

# =============================================================================
# LLM API Keys
# =============================================================================

# OpenAI API Key (for GPT models)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (for Claude models)  
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google API Key (for gemini models)
GOOGLE_API_KEY=your_google_api_key_here

# VertexAI Service Account File (for gemini models through VertexAI): json file
SERVICE_ACCOUNT_FILE=your_service_account_file_here

# Groq API Key (for fast inference)
GROQ_API_KEY=your_groq_api_key_here

# HuggingFace Token (for open source models)
HUGGINGFACE_TOKEN=your_huggingface_token_here

# =============================================================================
# LLM Configuration
# =============================================================================

# Default LLM provider (openai, anthropic, ollama, gemini)
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=llama3.1:8b
DEFAULT_LLM_BASE_URL=http://localhost:11434/v1
DEFAULT_LLM_TEMPERATURE=0.2
DEFAULT_MAX_TOKENS=8192
DEFAULT_TIMEOUT=1800
DEFAULT_MAX_RETRIES=2

# Ollama specific settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1:8b

# OpenAI specific settings
OPENAI_LLM_MODEL=gpt-5-nano

# Anthropic specific settings
ANTHROPIC_LLM_MODEL=claude-sonnet-4-0

# Google specific settings
GOOGLE_LLM_MODEL=gemini-2.5-flash

# VertexAI specific settings
VERTEX_LLM_MODEL=gemini-2.5-flash

# Groq specific settings
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# HuggingFace specific settings
HUGGINGFACE_LLM_MODEL=Qwen/Qwen3-235B-A22B
HUGGINGFACE_PROVIDER=nebius

# =============================================================================
# A2A Server Configuration
# =============================================================================

# A2A Server Configuration
A2A_HOST=localhost
A2A_PORT=8995

# =============================================================================
# MCP Server Configuration
# =============================================================================

# MCP configuration file path
MCP_CONFIG_PATH=${HLAGENT_MAIN_DIRECTORY}/config/mcp_config_HLAgent.json

# =============================================================================
# Web Search Configuration
# =============================================================================

TAVILY_API_KEY=your_tavily_api_key_here

# =============================================================================
# File Paths and Directories
# =============================================================================

# Data directory
DATA_DIR=data

# Input directory
DATA_INPUT_DIR=data/input

# Output directory  
DATA_OUTPUT_DIR=data/output

# Logs directory
LOGS_DIR=data/logs

# Temporary files directory
TEMP_DIR=data/temp


# =============================================================================
# Database Configuration
# =============================================================================

# ChromaDB settings for PydanticAI
CHROMA_PERSIST_DIRECTORY=${HLAGENT_MAIN_DIRECTORY}/data/chroma
CHROMA_COLLECTION_NAME=hla_knowledge_pa
CHROMA_PA_DIRECTORY=${HLAGENT_MAIN_DIRECTORY}/data/chroma/hla_knowledge_pa

# =============================================================================
# Docker Configuration
# =============================================================================

# Docker settings
DOCKER_ENABLED=true
DOCKER_NETWORK=hlagent-network

# CookHLA Docker image
COOKHLA_DOCKER_IMAGE="dhkwnr97/cookhla:latest"
HLAHD_DOCKER_IMAGE="varunkesherwani/hla-hd:latest"
OPTITYPE_DOCKER_IMAGE="fred2/optitype"

# =============================================================================
# Performance Settings
# =============================================================================

# Memory limits
MAX_MEMORY_GB=16
MEMORY_PER_PROCESS=4g

# CPU settings
MAX_CPU_CORES=4
PARALLEL_PROCESSES=4

# =============================================================================
# Development Settings
# =============================================================================

# Verbose logging
VERBOSE_LOGGING=true

# Save intermediate files
SAVE_INTERMEDIATES=false

# =============================================================================
# Logging Configuration
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path
LOG_FILE=data/logs/hlagent.log