# HLAgent v3 settings. Copy to .env and fill in what you use.
# Every key is optional: features without a key are disabled, and keys typed in the GUI override these.

# --- LLM providers ---
# DEFAULT_PROVIDER: google | openai | anthropic
DEFAULT_PROVIDER=google
GOOGLE_API_KEY=
GOOGLE_MODEL=google:gemini-3-flash-preview
GOOGLE_FALLBACK_MODEL=google:gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODEL=openai:gpt-5.5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=anthropic:claude-sonnet-5-5

# Local models via Ollama (model ids like ollama:llama3.1:8b)
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Optional services ---
# Tavily: web search for the HLA expert
TAVILY_API_KEY=
# TypeSafe Jev: decision model for routing (early access)
TYPESAFE_API_KEY=
ROUTER_JEV_MODEL=jev-latest
ROUTER_ROUTE_THRESHOLD=0.80

# --- RAG ---
# google:gemini-embedding-001 needs GOOGLE_API_KEY.
# sentence-transformers:BAAI/bge-m3 runs locally (install the [local-embed] extra).
EMBEDDING_MODEL=google:gemini-embedding-001

# --- Runtime ---
HLAGENT_MAX_PARALLEL_JOBS=1
# PLINK 1.9 executable name or path
HLAGENT_PLINK=plink
HLAGENT_PLINK2=plink2
HLAGENT_RSCRIPT=Rscript
HLAGENT_JAVA=java
HLAGENT_DOCKER=docker
